{
  "name": "@worldbookllm/server",
  "private": true,
  "version": "0.0.0",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json && esbuild src/index.ts src/app.ts --bundle --platform=node --format=esm --target=node24 --packages=external --alias:@worldbookllm/shared=../../packages/shared/src/index.ts --alias:@worldbookllm/providers=../../packages/providers/src/index.ts --outdir=dist",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/multipart": "10.1.2",
    "@fastify/static": "^10.1.5",
    "@joplin/turndown-plugin-gfm": "^1.0.68",
    "@mozilla/readability": "^0.6.0",
    "@worldbookllm/providers": "workspace:*",
    "@worldbookllm/shared": "workspace:*",
    "better-sqlite3": "13.0.3",
    "fastify": "^5.12.5",
    "gray-matter": "4.0.3",
    "linkedom": "^0.18.13",
    "story-skills": "0.18.0",
    "turndown": "^7.2.4",
    "unpdf": "^1.8.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "^24.19.0",
    "@types/turndown": "^5.0.6",
    "@vitest/coverage-v8": "^4.1.10",
    "esbuild": "0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
